{
    "name": "crypto-market-terminal",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "type-check": "vue-tsc -b",
        "lint": "eslint .",
        "lint:style": "stylelint \"src/**/*.{scss,vue}\"",
        "format": "prettier --write \"**/*.{ts,mjs,vue,scss,json,html}\" README.md \"tests/**/*.md\"",
        "format:check": "prettier --check \"**/*.{ts,mjs,vue,scss,json,html}\" README.md \"tests/**/*.md\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run type-check && npm run lint && npm run lint:style && npm run format:check && npm run test"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "lightweight-charts": "^5.2.1",
        "pinia": "^4.0.3",
        "vue": "^3.5.42",
        "vue-i18n": "^11.4.13",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "happy-dom": "^20.14.5",
        "jiti": "^2.7.0",
        "postcss-html": "^2.0.0",
        "prettier": "^3.9.9",
        "sass-embedded": "^1.105.1",
        "stylelint": "^17.16.0",
        "stylelint-config-recommended-vue": "^2.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.3",
        "vue-tsc": "^3.3.11"
    }
}
